DB_URL=jdbc:mysql://YOUR_SEOUL_RDS_ENDPOINT:3306/routia?serverTimezone=Asia/Seoul
DB_USERNAME=admin
DB_PASSWORD=
JPA_DDL_AUTO=none

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
# Must match the Google account that issued the Gmail app password.
MAIL_USERNAME=sender@gmail.com
# Use the 16-character app password without Google's display spaces.
MAIL_PASSWORD=
MAIL_FROM=sender@gmail.com
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
# Set true to fail startup when SMTP credentials are rejected.
MAIL_TEST_CONNECTION=false

JWT_SECRET=
JWT_ACCESS_EXPIRATION=3600
