DB_URL=jdbc:mysql://YOUR_SEOUL_RDS_ENDPOINT:3306/routia?serverTimezone=Asia/Seoul
DB_USERNAME=admin
DB_PASSWORD=
JPA_DDL_AUTO=none
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
# Must match the Google account that issued the Gmail app password.
MAIL_USERNAME=sender@gmail.com
# Use the 16-character app password without Google's display spaces.
MAIL_PASSWORD=
MAIL_FROM=sender@gmail.com
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
# Set true to fail startup when SMTP credentials are rejected.
MAIL_TEST_CONNECTION=false

JWT_SECRET=
JWT_ACCESS_EXPIRATION=3600

AI_PROVIDER=openai
OPENAI_API_KEY=
AI_MODEL=gpt-5.6-luna
AI_PROMPT_VERSION=routine-v2-onboarding-v2
AI_PROMPT_RESOURCE=classpath:prompts/routine-v2.txt
AI_REASONING_EFFORT=low
AI_MAX_OUTPUT_TOKENS=3000
AI_TIMEOUT_SECONDS=30

# Web FCM (service-account JSON must stay outside the repository)
NOTIFICATION_PROVIDER=unconfigured
GOOGLE_APPLICATION_CREDENTIALS=/secure/path/firebase-service-account.json
# Production only: one-line Base64 service-account JSON stored as a Cloudtype Secret.
FIREBASE_SERVICE_ACCOUNT_BASE64=
# Only used by ./gradlew externalFcmTest; never configure in production runtime.
TEST_FIREBASE_FID=
NOTIFICATION_SCHEDULER_DELAY_MS=60000
ROUTINE_GENERATION_LEAD_MINUTES=10
ROUTINE_DEFAULT_GENERATION_TIME=06:00
ROUTINE_DEFAULT_TIMEZONE=Asia/Seoul
AI_LOG_RESPONSE=false
ROUTINE_GENERATION_SCHEDULER_DELAY_MS=60000

# Local profile-image adapter directory. Replace the adapter when Object Storage is selected.
PROFILE_IMAGE_DIRECTORY=/tmp/routia-profile-images
